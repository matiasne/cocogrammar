# Postgres — point at the Supabase project's hosted Postgres (direct 5432 connection).
DATABASE_URL=postgres://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# AI providers
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
VOYAGE_API_KEY=pa-...

# Supabase Auth (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# MercadoPago (recurring preapproval subscription)
MP_ACCESS_TOKEN=APP_USR-...
# Public key for the embedded Card Payment Brick (Dashboard → Credentials → Public Key).
NEXT_PUBLIC_MP_PUBLIC_KEY=APP_USR-...
# Charge currency — MUST match your account's country (Argentina/MLA → ARS,
# Mexico → MXN, Brazil → BRL). Using the wrong currency is rejected.
MP_CURRENCY_ID=ARS
# Price in USD. It's converted to the charge currency above at the live FX rate
# (see src/lib/fx.ts), so the amount MercadoPago charges tracks the exchange rate.
MP_MONTHLY_AMOUNT_USD=5
# Last-resort USD→<currency> rate if every live FX source is unreachable.
MP_USD_ARS_FALLBACK=1450
# MercadoPago requires a PUBLIC https return URL and rejects localhost. For local
# testing, set this to a public tunnel (e.g. an ngrok https URL). In production it
# can be left unset if NEXT_PUBLIC_BASE_URL is already a public https URL.
MP_BACK_URL=https://your-public-tunnel.example.com

# App base URL (used for OAuth + MercadoPago redirect URLs)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
